<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1200</width><height>800</height></rect>
  </property>
  <property name="windowTitle">
   <string>Simple Editor</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QHBoxLayout" name="horizontalLayout">
    <item>
     <widget class="QWidget" name="leftPanel">
      <layout class="QVBoxLayout" name="leftLayout">
       <item>
        <widget class="QLabel" name="toolsLabel">
         <property name="text"><string>Tools</string></property>
         <property name="alignment"><set>Qt::AlignHCenter</set></property>
        </widget>
       </item>
       <item>
        <widget class="QListWidget" name="toolsList">
         <property name="minimumWidth"><number>180</number></property>
        </widget>
       </item>
       <item>
